# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Browser-safe public values only. Every VITE_ variable is embedded in the
# public JavaScript bundle, so never put a service_role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Browser-safe public Meta Pixel ID (numeric). This is not a CAPI token.
VITE_META_PIXEL_ID=
# Browser-safe Cloudinary cloud name. It appears in every delivery URL,
# so it is public by design. The key and secret below are NOT.
VITE_CLOUDINARY_CLOUD_NAME=

# SERVER ONLY — configure these in Netlify or another trusted server runtime.
# Never prefix these values with VITE_ and never commit actual values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PIN_PEPPER=
ADMIN_SESSION_SECRET=
ADMIN_LOCKOUT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
ADMIN_NOTIFICATION_EMAIL=bangprivatetattoos@gmail.com
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional; use a currently supported Meta Graph API version.
META_GRAPH_API_VERSION=

# Development only. When "true", the video feed's reaction control shows
# placeholder counts so the layout can be reviewed with numbers present.
# These are NOT real activity. Production builds ignore this entirely — the
# flag is gated behind import.meta.env.DEV, so setting it here cannot turn
# placeholder counts on for visitors. Leave it false.
VITE_ENABLE_MOCK_ENGAGEMENT=false

# SERVER / LOCAL TOOLING ONLY — used by `npm run media:sync`.
# Never prefix these with VITE_: every VITE_ variable is compiled into the
# public browser bundle. These belong in .env.local or your shell only,
# and .env.local is gitignored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
